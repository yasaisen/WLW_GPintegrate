{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "darkWLW CaseList input v1.0",
  "type": "object",
  "required": ["DxItem_list", "case_list"],
  "additionalProperties": false,
  "properties": {
    "DxItem_list": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "case_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "metadata_case_payload.schema.json#/$defs/sourceCase"
      }
    }
  }
}
