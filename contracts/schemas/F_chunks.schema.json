{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "F.Chunks v1.0",
  "type": "object",
  "required": ["contract", "schema_version", "artifact_id", "case_id", "producer", "payload"],
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "F.Chunks"},
    "schema_version": {"const": "1.0"},
    "artifact_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "payload": {
      "type": "object",
      "required": ["chunks"],
      "additionalProperties": false,
      "properties": {
        "chunks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["chunk_id", "dx_pair_id", "literature_id", "text", "visual_attributes", "relevance_score"],
            "additionalProperties": false,
            "properties": {
              "chunk_id": {"type": "string", "minLength": 1},
              "dx_pair_id": {"type": "string", "minLength": 1},
              "literature_id": {"type": "string", "minLength": 1},
              "text": {"type": "string", "minLength": 1},
              "visual_attributes": {"type": "array", "items": {"type": "string"}},
              "relevance_score": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    }
  }
}

