{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "F.Chunks v2.0",
  "type": "object",
  "required": ["contract", "schema_version", "artifact_id", "case_id", "producer", "payload"],
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "F.Chunks"},
    "schema_version": {"const": "2.0"},
    "artifact_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "payload": {
      "type": "object",
      "required": ["corpus_id", "knowledge_base", "chunks"],
      "additionalProperties": false,
      "properties": {
        "corpus_id": {"type": "string", "minLength": 1},
        "knowledge_base": {
          "type": "object",
          "required": [
            "knowledge_base_id", "archive_path", "archive_sha256",
            "corpus_sha256", "embedding_model_path", "embedding_model_sha256",
            "document_count", "max_tokens", "query_max_tokens", "retrieval_mode", "top_k",
            "candidate_k", "hybrid_weights"
          ],
          "additionalProperties": false,
          "properties": {
            "knowledge_base_id": {"type": "string", "minLength": 1},
            "archive_path": {"type": "string", "minLength": 1},
            "archive_sha256": {"type": "string", "minLength": 1},
            "corpus_sha256": {"type": "string", "minLength": 1},
            "embedding_model_path": {"type": "string", "minLength": 1},
            "embedding_model_sha256": {"type": "string", "minLength": 1},
            "document_count": {"type": "integer", "minimum": 1},
            "max_tokens": {"type": "integer", "minimum": 1},
            "query_max_tokens": {"type": "integer", "minimum": 1},
            "retrieval_mode": {"enum": ["dense", "sparse", "hybrid"]},
            "top_k": {"type": "integer", "minimum": 1},
            "candidate_k": {"type": "integer", "minimum": 1},
            "hybrid_weights": {
              "type": "object",
              "required": ["dense", "sparse"],
              "additionalProperties": false,
              "properties": {
                "dense": {"type": "number", "minimum": 0},
                "sparse": {"type": "number", "minimum": 0}
              }
            }
          }
        },
        "chunks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "chunk_id", "dx_pair_id", "literature_id", "section_id", "source_idx",
              "section_idx", "title_list", "literature_title", "section_title",
              "source_href", "text", "indexed_token_count", "retrieval_rank",
              "dense_score", "dense_rank", "sparse_score", "sparse_rank",
              "relevance_score"
            ],
            "additionalProperties": false,
            "properties": {
              "chunk_id": {"type": "string", "minLength": 1},
              "dx_pair_id": {"type": "string", "minLength": 1},
              "literature_id": {"type": "string", "minLength": 1},
              "section_id": {"type": "string", "minLength": 1},
              "source_idx": {"type": "integer", "minimum": 0},
              "section_idx": {"type": "integer", "minimum": 0},
              "title_list": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {"type": ["string", "null"]}
              },
              "literature_title": {"type": "string", "minLength": 1},
              "section_title": {"type": "string", "minLength": 1},
              "source_href": {"type": ["string", "null"]},
              "text": {"type": "string", "minLength": 1},
              "indexed_token_count": {"type": "integer", "minimum": 1},
              "retrieval_rank": {"type": "integer", "minimum": 1},
              "dense_score": {"type": ["number", "null"]},
              "dense_rank": {"type": ["integer", "null"], "minimum": 1},
              "sparse_score": {"type": ["number", "null"], "minimum": 0},
              "sparse_rank": {"type": ["integer", "null"], "minimum": 1},
              "relevance_score": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    }
  }
}
