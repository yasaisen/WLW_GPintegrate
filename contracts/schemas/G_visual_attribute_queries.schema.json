{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G.VisualAttributeQueries v1.0",
  "type": "object",
  "required": ["contract", "schema_version", "artifact_id", "case_id", "producer", "payload"],
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "G.VisualAttributeQueries"},
    "schema_version": {"const": "1.0"},
    "artifact_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "payload": {
      "type": "object",
      "required": ["queries"],
      "additionalProperties": false,
      "properties": {
        "queries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["query_id", "dx_pair_id", "text", "required_attributes"],
            "additionalProperties": false,
            "properties": {
              "query_id": {"type": "string", "minLength": 1},
              "dx_pair_id": {"type": "string", "minLength": 1},
              "text": {"type": "string", "minLength": 1},
              "required_attributes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}

