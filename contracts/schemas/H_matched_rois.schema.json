{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "H.MatchedROIs v1.0",
  "type": "object",
  "required": ["contract", "schema_version", "artifact_id", "case_id", "producer", "payload"],
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "H.MatchedROIs"},
    "schema_version": {"const": "1.0"},
    "artifact_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "payload": {
      "type": "object",
      "required": ["matches"],
      "additionalProperties": false,
      "properties": {
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["match_id", "dx_pair_id", "query_id", "roi_id", "wsi_id", "image_uri", "coordinate", "resolution", "matched_attributes", "score"],
            "additionalProperties": false,
            "properties": {
              "match_id": {"type": "string", "minLength": 1},
              "dx_pair_id": {"type": "string", "minLength": 1},
              "query_id": {"type": "string", "minLength": 1},
              "roi_id": {"type": "string", "minLength": 1},
              "wsi_id": {"type": "string", "minLength": 1},
              "image_uri": {"type": "string", "minLength": 1},
              "coordinate": {
                "type": "object",
                "required": ["x", "y", "width", "height", "level"],
                "additionalProperties": false,
                "properties": {
                  "x": {"type": "integer", "minimum": 0},
                  "y": {"type": "integer", "minimum": 0},
                  "width": {"type": "integer", "minimum": 1},
                  "height": {"type": "integer", "minimum": 1},
                  "level": {"type": "integer", "minimum": 0}
                }
              },
              "resolution": {
                "type": "object",
                "required": ["mpp", "magnification"],
                "additionalProperties": false,
                "properties": {
                  "mpp": {
                    "type": "object",
                    "required": ["x", "y"],
                    "additionalProperties": false,
                    "properties": {
                      "x": {"type": "number", "minimum": 0},
                      "y": {"type": "number", "minimum": 0}
                    }
                  },
                  "magnification": {"type": "number", "minimum": 0}
                }
              },
              "matched_attributes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "score": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    }
  }
}
