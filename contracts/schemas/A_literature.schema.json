{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A.Literature v1.0",
  "type": "object",
  "required": ["contract", "schema_version", "artifact_id", "payload"],
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "A.Literature"},
    "schema_version": {"const": "1.0"},
    "artifact_id": {"type": "string", "minLength": 1},
    "payload": {
      "type": "object",
      "required": ["documents"],
      "additionalProperties": false,
      "properties": {
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["literature_id", "title", "text", "keywords", "visual_attributes"],
            "additionalProperties": false,
            "properties": {
              "literature_id": {"type": "string", "minLength": 1},
              "title": {"type": "string", "minLength": 1},
              "text": {"type": "string", "minLength": 1},
              "keywords": {"type": "array", "items": {"type": "string"}},
              "visual_attributes": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}

