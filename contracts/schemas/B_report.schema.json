{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B.Report v1.0",
  "type": "object",
  "required": ["contract", "schema_version", "artifact_id", "case_id", "payload"],
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "B.Report"},
    "schema_version": {"const": "1.0"},
    "artifact_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "payload": {
      "type": "object",
      "required": ["report_id", "raw_text", "observations"],
      "additionalProperties": false,
      "properties": {
        "report_id": {"type": "string", "minLength": 1},
        "raw_text": {"type": "string", "minLength": 1},
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["dx_item", "dx_result"],
            "additionalProperties": false,
            "properties": {
              "dx_item": {"type": "string", "minLength": 1},
              "dx_result": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}

