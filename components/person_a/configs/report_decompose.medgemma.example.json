{
  "component_version": "person-a/report-decompose:0.4.0-medgemma",
  "dx_candidates_path": "/references/DxStructuredCandidates_integrated.json",
  "wsi_discovery": {
    "mode": "case_directory_he",
    "root": "/data/wsi",
    "recursive": true,
    "extensions": [".mrxs", ".ndpi", ".svs", ".tif", ".tiff"],
    "he_tokens": ["HE", "H01"],
    "hospital_subdirectories": {},
    "default_block_id": "UNSPECIFIED"
  },
  "report_extraction": {
    "enabled": true,
    "backend": "hospital_routed",
    "only_when_missing": true,
    "strict_result_classes": false,
    "item_name_map": {},
    "result_class_map": {},
    "medgemma": {
      "model_id": "google/medgemma-1.5-4b-it",
      "token_env": "HF_TOKEN",
      "load_in_4bit": true,
      "chunk_chars": 6500,
      "overlap": 700,
      "max_input_tokens": 4096,
      "max_new_tokens": 1200
    }
  }
}
