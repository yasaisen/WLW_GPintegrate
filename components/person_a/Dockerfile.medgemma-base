FROM python:3.11-slim-bookworm@sha256:2fc9207f64226cb05ac317cee0bab6fa55a9ea311ce5a086baddd4b4a83c2d3c

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    HF_HOME=/models/huggingface \
    TOKENIZERS_PARALLELISM=false \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

WORKDIR /app

RUN apt-get update \
    && apt-get install --yes --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# CUDA is supplied by the official PyTorch cu124 wheels.  The host still needs
# the NVIDIA Container Toolkit/driver, but no CUDA toolkit is copied from host.
RUN python -m pip install --no-cache-dir --disable-pip-version-check \
    torch==2.6.0 torchvision==0.21.0 \
    --index-url https://download.pytorch.org/whl/cu124

COPY components/person_a/requirements-medgemma.txt /tmp/requirements-medgemma.txt
RUN python -m pip install --no-cache-dir --disable-pip-version-check \
    -r /tmp/requirements-medgemma.txt

RUN mkdir -p /models/huggingface /app/components
